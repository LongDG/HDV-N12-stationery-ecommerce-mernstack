# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text
*.txt text
*.json text eol=lf

# Scripts
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary